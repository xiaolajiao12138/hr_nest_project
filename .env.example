# ========================================================
# HR 人事管理系统 Docker Compose 生产环境变量配置示例
# 部署时复制为 .env 文件并填入真实密钥：cp .env.example .env
# ========================================================

# PostgreSQL 数据库配置
DB_USER=hr_admin
DB_PASSWORD=hr_password_2026
DB_DATABASE=hr_manage_db

# Redis 缓存密码
REDIS_PASSWORD=hr_redis_2026

# MinIO 对象存储账号与密码
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_2026

# JWT 生产签名密钥（强烈建议替换为高强度随机字符串）
JWT_SECRET=hr_jwt_secret_prod_2026_super_key
REFRESH_TOKEN_SECRET=hr_refresh_token_secret_prod_2026_super_key

# 右下角 AI 智能体大模型配置（必填 LLM_API_KEY 方可启用智能对话）
LLM_API_KEY=
LLM_BASE_URL=https://sub2api.starysp.top/v1
LLM_MODEL=gpt-6.1-sol
