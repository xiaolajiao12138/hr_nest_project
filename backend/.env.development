# ==========================================
# 本地开发环境配置 (Local Development)
# ==========================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# 数据库配置 (PostgreSQL) - 本地允许 synchronize
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=hr_password_2026
DB_DATABASE=hr_manage_db
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis 缓存配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=hr_redis_2026
REDIS_DB=0

# MinIO 对象存储 (Local桶隔离)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_2026
MINIO_BUCKET_NAME=hr-local-files

# JWT 鉴权与刷新Token配置
JWT_SECRET=hr_jwt_secret_dev_2026_key
JWT_EXPIRES_IN=7200s
REFRESH_TOKEN_SECRET=hr_refresh_token_secret_dev_2026_key
REFRESH_TOKEN_EXPIRES_IN=7d

# 系统与安全
ENABLE_RATE_LIMIT=false
ENABLE_HELMET=false
LOG_LEVEL=debug
MASK_STACK_ERROR=false
