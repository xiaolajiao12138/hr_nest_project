# ==========================================
# 测试环境配置 (Test Environment)
# ==========================================
NODE_ENV=test
PORT=3000
API_PREFIX=/api

# 数据库配置 (PostgreSQL) - 关闭自动同步，通过 Migration 脚本管理
DB_TYPE=postgres
DB_HOST=10.0.0.10
DB_PORT=5432
DB_USER=hr_test_user
DB_PASSWORD=hr_test_pwd_2026
DB_DATABASE=hr_test_db
DB_SYNCHRONIZE=false
DB_LOGGING=warn

# Redis 缓存配置 (独立Redis)
REDIS_HOST=10.0.0.11
REDIS_PORT=6379
REDIS_PASSWORD=hr_test_redis_2026
REDIS_DB=1

# MinIO 对象存储 (Test桶隔离)
MINIO_ENDPOINT=minio-test.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=test_minio_admin
MINIO_SECRET_KEY=test_minio_pass_2026
MINIO_BUCKET_NAME=hr-test-files

# JWT 鉴权
JWT_SECRET=hr_jwt_secret_test_2026_xyz
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_SECRET=hr_refresh_token_test_2026_xyz
REFRESH_TOKEN_EXPIRES_IN=7d

# 系统日志与安全 - 开启文件输出日志
ENABLE_RATE_LIMIT=true
ENABLE_HELMET=true
LOG_LEVEL=info
MASK_STACK_ERROR=false
LOG_FILE_PATH=./logs
