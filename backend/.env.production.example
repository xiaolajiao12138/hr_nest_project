# ==============================================================================
# 生产环境配置模板 (Production Environment Template)
# 部署说明: 复制本文件为 .env.production 并填入生产环境真实凭据
# ==============================================================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api

# 数据库配置 (若是 Docker Compose 部署，DB_HOST 保持为服务名 postgres；若是云数据库 RDS，则填外网/内网域名)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=hr_admin
DB_PASSWORD=hr_password_2026
DB_DATABASE=hr_manage_db
DB_SYNCHRONIZE=false
DB_LOGGING=error

# Redis 缓存配置 (若是 Docker Compose 部署，REDIS_HOST 保持为服务名 redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=hr_redis_2026
REDIS_DB=0

# 对象存储 (默认连接 Docker Compose 内置 MinIO 容器；亦可无缝切换阿里云 OSS / 腾讯云 COS 兼容 S3 协议)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_2026
MINIO_BUCKET_NAME=hr-local-files

# JWT 鉴权密钥 (生产环境建议替换为 64 位以上随机强密钥)
JWT_SECRET=hr_jwt_secret_prod_2026_super_key!#xyz
JWT_EXPIRES_IN=7200s
REFRESH_TOKEN_SECRET=hr_refresh_token_secret_prod_2026_super_key!#xyz
REFRESH_TOKEN_EXPIRES_IN=7d

# 生产级安全防护
ENABLE_RATE_LIMIT=true
ENABLE_HELMET=true
LOG_LEVEL=warn
MASK_STACK_ERROR=true
