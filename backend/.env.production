# ==========================================
# 生产环境配置 (Production Environment)
# ==========================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api

# 生产数据库配置 (禁止synchronize，高可用连接池)
DB_TYPE=postgres
DB_HOST=pg-prod.internal
DB_PORT=5432
DB_USER=hr_prod_user
DB_PASSWORD=hr_prod_super_secret_2026!
DB_DATABASE=hr_prod_db
DB_SYNCHRONIZE=false
DB_LOGGING=error

# 生产 Redis 缓存
REDIS_HOST=redis-prod.internal
REDIS_PORT=6379
REDIS_PASSWORD=hr_prod_redis_pass_2026!
REDIS_DB=0

# 生产对象存储 (可切换为阿里云OSS兼容S3协议端点，或者生产MinIO集群)
MINIO_ENDPOINT=oss-cn-beijing.aliyuncs.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=PROD_OSS_ACCESS_KEY_ID
MINIO_SECRET_KEY=PROD_OSS_ACCESS_KEY_SECRET
MINIO_BUCKET_NAME=hr-prod-assets

# JWT 安全密钥
JWT_SECRET=PROD_ULTRA_SECURE_JWT_SECRET_STRING_2026_XYZ!#
JWT_EXPIRES_IN=1800s
REFRESH_TOKEN_SECRET=PROD_ULTRA_SECURE_REFRESH_TOKEN_STRING_2026_XYZ!#
REFRESH_TOKEN_EXPIRES_IN=3d

# 生产级安全防护：限流开启、安全头开启、屏蔽底层堆栈
ENABLE_RATE_LIMIT=true
ENABLE_HELMET=true
LOG_LEVEL=warn
MASK_STACK_ERROR=true
LOG_FILE_PATH=/var/log/hr_backend
