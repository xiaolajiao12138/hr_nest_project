# ==============================================================================
#                 企业级通用 Git 忽略规则 (.gitignore)
#                 适用技术栈: Node.js / NestJS / Vue3 / Vite / TypeScript
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 依赖管理目录 (Dependencies)
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# 2. 编译与构建产物 (Build Outputs)
# ------------------------------------------------------------------------------
dist/
*/dist/
build/
*/build/
out/
*/out/
.output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. 环境变量与安全机密 (Environment & Secrets - 防泄漏企业红线)
# ------------------------------------------------------------------------------
# 包含实际密钥、账号或本地定制的环境配置
.env.local
.env.*.local
*.local

# 生产环境真实敏感配置 (保留 .env.production.example 作为部署模板)
backend/.env.production
frontend/.env.production

# 证书、私钥与敏感令牌
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
id_rsa
id_rsa.pub

# ------------------------------------------------------------------------------
# 4. 运行期数据与存储 (Runtime Data, Storage & Uploads)
# ------------------------------------------------------------------------------
# 上传的临时与用户附件
uploads/
*/uploads/
storage/
*/storage/
temp/
*/temp/
tmp/
*/tmp/
.temp/
.cache/
*.tmp

# 本地数据卷与备份
*.dump
*.sql.gz
*.tar.gz
*.bak

# ------------------------------------------------------------------------------
# 5. 日志文件 (Logs & Diagnostics)
# ------------------------------------------------------------------------------
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 6. 自动化测试与覆盖率分析 (Testing & Coverage)
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
test-results/

# ------------------------------------------------------------------------------
# 7. IDE 与开发工具缓存 (IDE & Editor Settings)
# ------------------------------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
.fleet/

# VS Code - 忽略用户个人状态与缓存，允许提交通用推荐插件与格式化规范
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 8. 操作系统级生成文件 (OS Generated Files)
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 9. Superpowers 临时设计会话 (Brainstorm Companion)
# ------------------------------------------------------------------------------
.superpowers/

